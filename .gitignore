out/
dist/
build/

# VS Code specific files
*.vsix
.vscode-test/

# Environment files
.env
.env.local
.env.*

# Claude Code: ignore local/user-specific files only.
# The vendored skill trees (.agents/skills/, .claude/skills/) and the shared
# .claude/settings.json are deliberately committed. Do not ignore them.
.claude/*.local.*
.claude/todos/
.claude/worktrees/
.superpowers/

# Python: pre-commit lives in a local venv managed with uv
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# IDE specific files
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

